# -------------------------------------------------------
# Castle of Princes — Environment Variables Example
# -------------------------------------------------------
# Copy this file to .env.local and fill in your values.
# Contact ayancse2001@gmail.com to obtain actual credentials.
# -------------------------------------------------------


# Site URL
NEXT_PUBLIC_SITE_URL=https://your-domain.com


# Database
MONGODB_URI=


# Auth
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=          # Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"


# Default admin (auto-created in DB on first login if not present)
DEFAULT_ADMIN_NAME=
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=


# Cloudinary (required for CMS image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# Resend (transactional email)
RESEND_API_KEY=


# Gmail SMTP (password reset emails)
GMAIL_USER=
GMAIL_PASS=


# SSLCommerz (payment gateway)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true


# EmailJS (client-side contact form)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
